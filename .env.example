# AuK Local Studio 配置模板
# 复制为 .env 后按需修改；start.sh 不会自动加载 .env（如需加载：set -a; source .env; set +a）
# 所有变量也可直接以环境变量形式注入。

# 服务监听（默认仅本机，勿改为 0.0.0.0 除非你清楚风险）
AUK_HOST=127.0.0.1
AUK_PORT=7860

# 目录（默认相对项目根目录）
# AUK_DATA_DIR=./data
# AUK_MODELS_DIR=./models
# AUK_LOGS_DIR=./logs
# AUK_REPO=./AuK
# AUK_VENV_PYTHON=./.venv-auk/bin/python

# 上传限制
AUK_MAX_UPLOAD_MB=200
AUK_MAX_DURATION_S=600

# 推理默认（官方建议 8-bit；4-bit 中文发音退化，不建议）
AUK_DEFAULT_BITS=8
AUK_DEFAULT_SEQUENTIAL=0
AUK_MODEL_IDLE_UNLOAD_S=900

# 拼接导出默认交叉淡化
AUK_DEFAULT_CROSSFADE_MS=30

# 下载/安装辅助（scripts 使用）
AUK_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
AUK_SOCKS_PROXY=socks5h://127.0.0.1:7897
HF_PROXY=socks5h://127.0.0.1:7897

# 注意：本项目不配置任何云端模型 API；推理完全在本机 MLX/Metal 运行。